  "cards": [
    {
      "dot": "cyan",
      "title": "Mô hình Django MVT (Monolith)",
      "items": [
        "Model: Định nghĩa cấu trúc dữ liệu và logic truy vấn thông qua Django ORM.",
        "View: Tiếp nhận request, xử lý nghiệp vụ và nạp dữ liệu context vào template.",
        "Template: Động cơ DTL thực hiện Server-Side Rendering (SSR) sinh HTML/CSS trả về trình duyệt.",
        "Hạn chế: Ghép chặt tầng giao diện với backend, khó tái sử dụng cho mobile app hoặc microservices."
      ]
    },
    {
      "dot": "emerald",
      "title": "Mô hình DRF (Model – Serializer – View)",
      "items": [
        "View / ViewSet: Điều phối endpoint RESTful, kiểm soát xác thực JWT, phân quyền và filter.",
        "Serializer: Đảm nhận chuyển đổi 2 chiều: Deserialization (validate request data) và Serialization (Model -> JSON DTO).",
        "Model: Giữ nguyên vai trò ORM, hoàn toàn độc lập với hình thức trình diễn dữ liệu.",
        "Ưu điểm: Tách rời hoàn toàn frontend & backend, hỗ trợ kiến trúc hướng dịch vụ (SOA) và API-first."
      ]
    },
    {
      "dot": "rose",
      "title": "Điểm chuyển dịch cốt lõi",
      "items": [
        "Serializer thay thế hoàn toàn vai trò của Template trong việc làm trung gian định dạng dữ liệu.",
        "Định dạng trao đổi tiêu chuẩn chuyển từ tài liệu HTML tĩnh sang dữ liệu cấu trúc JSON chuẩn REST.",
        "Phù hợp nguyên lý SOA: Các dịch vụ độc lập giao tiếp qua chuẩn HTTP/REST DTOs."
      ]
    }
  ]
