  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Stateless JWT Verification",
      "items": [
        "Client đính kèm Bearer Token trong Authorization header qua mỗi request.",
        "regist-service giải mã token tại chỗ (local JWT verification) bằng khóa chung JWT_SIGNING_KEY và kiểm tra Role = 3 (Sinh viên)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Cross-Service REST Validation",
      "items": [
        "Tuân thủ nghiêm ngặt nguyên lý SOA: regist-service không query bảng Students hay Topics.",
        "Các nghiệp vụ kiểm tra điều kiện sinh viên và trạng thái đề tài được ủy quyền qua HTTP/REST API của academic-service và topic-service."
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & Async Logging",
      "items": [
        "Lưu bản ghi vào bảng Registrations (thuộc quyền sở hữu của regist-service) với Status khởi tạo là 1 (Chờ duyệt).",
        "Bắn thông điệp ghi log audit bất đồng bộ sang log-service mà không làm nghẽn luồng xử lý chính."
      ]
    }
  ]
