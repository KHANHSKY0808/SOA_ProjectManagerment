  "cards": [
    {
      "dot": "cyan",
      "title": "SOA Principles & Discovery",
      "items": [
        "Independent Django REST services with clear domain boundaries",
        "HashiCorp Consul handles dynamic instance registration and health checking (:8500)",
        "Nginx API Gateway dynamically discovers healthy upstreams and forwards correlation IDs"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Policy Management",
      "items": [
        "auth-service issues stateless JWT tokens with role-based claims",
        "Microservices independently verify JWT signature and expiration",
        "Inter-service internal calls use protected INTERNAL_SERVICE_TOKEN"
      ]
    },
    {
      "dot": "emerald",
      "title": "Database-First & Storage Isolation",
      "items": [
        "Services share the physical SQLite file database/DB_ProjectManagerment.db",
        "Strict logical table ownership: services read and write only their assigned tables",
        "Cross-service data references rely strictly on IDs exchanged via HTTP/REST contracts"
      ]
    }
  ]
