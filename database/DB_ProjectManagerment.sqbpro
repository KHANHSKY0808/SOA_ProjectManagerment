ame="SQL 1*">-- Source: https://tuyensinh.qnu.edu.vn/vi/de-an-tuyen-sinh-2020/danh-sach-giang-vien-co-huu
-- Historical admissions list, not a verified current staff directory.
-- 518 source rows; generated IDs GV0001..GV0518 are NOT official staff IDs.
-- Faculty assignments are INFERRED from training specialty and teaching program.
-- Review lecturers_faculty_mapping.csv before use; assignments are not official.
-- Password: lecture; Role: 2; Status: 1. Email and phone are synthetic.
-- Missing birth dates remain NULL. Duplicate names remain separate source rows.
-- Run entire file in DB Browser, then click Write Changes.
-- Uses a nested SAVEPOINT to preserve DB Browser's own UNDOPOINT.
PRAGMA foreign_keys = ON;
SAVEPOINT qnu_lecturers_import;

CREATE TEMP TABLE &quot;_qnu_lecturer_source&quot; (
    UserId TEXT PRIMARY KEY, LastName TEXT, FirstName TEXT, Gender INTEGER,
    Email TEXT, Phone TEXT, FacultyId TEXT
);
