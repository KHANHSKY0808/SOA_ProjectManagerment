-- These rows are skipped if the proposed faculty is absent from the database.
SELECT s.UserId, s.LastName, s.FirstName, s.FacultyId AS MissingFacultyId
FROM &quot;_qnu_lecturer_source&quot; s
LEFT JOIN Faculties f ON f.FacultyId = s.FacultyId
WHERE s.FacultyId IS NOT NULL AND f.FacultyId IS NULL;

INSERT INTO Users (
    UserId, LastName, FirstName, Gender, DateOfBirth, Password,
    Email, Phone, Role, Status, CreatedAt, UpdatedAt
)
SELECT s.UserId, s.LastName, s.FirstName, s.Gender, NULL, 'lecture',
       s.Email, s.Phone, 2, 1, NULL, NULL
FROM &quot;_qnu_lecturer_source&quot; s
WHERE s.FacultyId IS NULL OR EXISTS (
    SELECT 1 FROM Faculties f WHERE f.FacultyId = s.FacultyId
)
ON CONFLICT(UserId) DO NOTHING;

INSERT INTO Lecturers (LecturerId, FacultyId)
SELECT s.UserId, s.FacultyId
FROM &quot;_qnu_lecturer_source&quot; s
JOIN Users u ON u.UserId = s.UserId AND u.Role = 2
WHERE s.FacultyId IS NULL OR EXISTS (
    SELECT 1 FROM Faculties f WHERE f.FacultyId = s.FacultyId
)
ON CONFLICT(LecturerId) DO NOTHING;

SELECT l.FacultyId, f.FacultyName, COUNT(*) AS ImportedLecturerCount
FROM Lecturers l
JOIN &quot;_qnu_lecturer_source&quot; s ON s.UserId = l.LecturerId
LEFT JOIN Faculties f ON f.FacultyId = l.FacultyId
GROUP BY l.FacultyId, f.FacultyName;

DROP TABLE &quot;_qnu_lecturer_source&quot;;
RELEASE SAVEPOINT qnu_lecturers_import;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
